[flake8]
# QGIS plugin codebase conventions:
# - E501: pre-existing code contains very long lines; line-length is not enforced.
# - W503/W504: mutually exclusive line-break rules; both styles are used.
extend-ignore = E501, W503, W504

# functions/user_functions.py is the seeded upstream QGIS_user_function
# library: 'from qgis.core import *' is the intended user-facing API surface
# (@qgsfunction etc. resolve through it).
per-file-ignores =
    functions/user_functions.py: F403, F405, F841, W605
