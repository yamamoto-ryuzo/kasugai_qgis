      <layout class="QVBoxLayout" name="verticalLayout_tab_layers">
       <item>
        <widget class="QCheckBox" name="checkBox_site_control">
         <property name="text">
          <string>Custom layers tab</string>
         </property>
         <property name="toolTip">
          <string>Group layers by their layer-tree group name into a custom "Layers" tab in KASUGAI Canvas (site=&lt;group&gt; on each layer row + custom-layer plugin tab for per-group on/off and ordering). All layers stay on the standard tab (shown as "System layers" while the custom tab exists); use list=off to hide a row there. Ungrouped layers go to "Misc". Per-layer override: layer custom properties kasugai_site / kasugai_order</string>
         </property>
         <property name="checked">
          <bool>false</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="label_kasugai_layers_hint">
         <property name="text">
          <string>Per-layer .kasc options (saved to the layer; gray = auto value): site=control group (blank=auto/"-"=Misc), order=rank within site (set via VIEW mode ▲▼), list=hide from layer list, opts=extra key=value (legend_order=asc|desc|reverse|A,B,C reorders legend entries)</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
